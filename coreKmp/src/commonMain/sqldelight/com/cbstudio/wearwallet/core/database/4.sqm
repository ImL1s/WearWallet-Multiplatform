-- Migration from Schema v4 to Schema v5
-- PR #32 Round 9: Persistent 5-State Deletion Journal

CREATE TABLE IF NOT EXISTS deletion_journal (
    wallet_id INTEGER PRIMARY KEY NOT NULL,
    key_alias TEXT,
    state TEXT NOT NULL,
    last_error TEXT,
    retry_count INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_deletion_journal_state ON deletion_journal(state);
