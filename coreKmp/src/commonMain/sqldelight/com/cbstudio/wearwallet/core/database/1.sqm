-- Migration from Schema v1 to Schema v2
-- PR #32 Round 5: Add KeyVault identity, backend, format version, and authorization requirement columns

ALTER TABLE wallet ADD COLUMN key_alias TEXT;
ALTER TABLE wallet ADD COLUMN key_backend TEXT NOT NULL DEFAULT 'LEGACY_ENCRYPTED_PREFS';
