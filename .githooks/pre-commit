#!/bin/bash

# KMP Integration Tests Pre-commit Hook
# This hook runs essential tests before allowing a commit

set -e

echo "🔍 Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to run tests
run_test_suite() {
    local test_class=$1
    local description=$2
    
    echo -e "${BLUE}Testing: $description${NC}"
    
    if ./gradlew :wear:testDebugUnitTest --tests "$test_class" -q > /dev/null 2>&1; then
        echo -e "${GREEN}✅ $description${NC}"
        return 0
    else
        echo -e "${RED}❌ $description${NC}"
        return 1
    fi
}

# Check if we're in the project root
if [ ! -f "gradlew" ]; then
    echo -e "${RED}Error: Not in project root directory${NC}"
    exit 1
fi

# Skip tests if SKIP_TESTS is set
if [ "$SKIP_TESTS" = "true" ]; then
    echo -e "${YELLOW}⚠️  Tests skipped (SKIP_TESTS=true)${NC}"
    exit 0
fi

# Skip tests for WIP commits
if git diff --cached --name-only | grep -q "WIP\|wip\|Work in progress"; then
    echo -e "${YELLOW}⚠️  WIP commit detected, skipping tests${NC}"
    exit 0
fi

echo -e "${BLUE}Running critical test suites...${NC}"

# Track failures
FAILED_TESTS=()

# Run critical test suites
CRITICAL_TESTS=(
    "com.cbstudio.wearwallet.di.SimplifiedKoinIntegrationTest:DI Integration"
    "com.cbstudio.wearwallet.integration.SimplifiedDataFlowTest:Data Flow"
    "com.cbstudio.wearwallet.keystone.SimplifiedKeystoneTest:Keystone Integration"
    "com.cbstudio.wearwallet.presentation.wallet.screens.main.SimpleViewModelBridgeTest:ViewModel Bridge"
)

for test in "${CRITICAL_TESTS[@]}"; do
    IFS=':' read -r class desc <<< "$test"
    if ! run_test_suite "$class" "$desc"; then
        FAILED_TESTS+=("$desc")
    fi
done

# Check for Kotlin compilation
echo -e "${BLUE}Checking Kotlin compilation...${NC}"
if ./gradlew :wear:compileDebugKotlin -q > /dev/null 2>&1; then
    echo -e "${GREEN}✅ Kotlin compilation successful${NC}"
else
    echo -e "${RED}❌ Kotlin compilation failed${NC}"
    FAILED_TESTS+=("Kotlin Compilation")
fi

# Run ktlint if available
if [ -f "./.gradle/ktlint" ]; then
    echo -e "${BLUE}Running ktlint...${NC}"
    if ./gradlew ktlintCheck -q > /dev/null 2>&1; then
        echo -e "${GREEN}✅ Code style check passed${NC}"
    else
        echo -e "${YELLOW}⚠️  Code style issues found (non-blocking)${NC}"
        echo "Run './gradlew ktlintFormat' to fix style issues"
    fi
fi

# Check for test files in staged changes
STAGED_TEST_FILES=$(git diff --cached --name-only | grep -E "Test\.kt$" || true)
if [ -n "$STAGED_TEST_FILES" ]; then
    echo -e "${BLUE}Test files modified, running affected tests...${NC}"
    
    for file in $STAGED_TEST_FILES; do
        # Extract test class name from file path
        TEST_CLASS=$(echo "$file" | sed 's/.*src\/test\/java\///' | sed 's/\.kt$//' | tr '/' '.')
        
        if [ -n "$TEST_CLASS" ]; then
            if ! run_test_suite "$TEST_CLASS" "Modified: $TEST_CLASS"; then
                FAILED_TESTS+=("$TEST_CLASS")
            fi
        fi
    done
fi

# Summary
echo ""
echo -e "${BLUE}========================================${NC}"
if [ ${#FAILED_TESTS[@]} -eq 0 ]; then
    echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
    echo -e "${BLUE}========================================${NC}"
    
    # Show quick stats
    STAGED_FILES=$(git diff --cached --numstat | wc -l)
    echo -e "${GREEN}Ready to commit $STAGED_FILES file(s)${NC}"
    
    exit 0
else
    echo -e "${RED}❌ Pre-commit checks failed!${NC}"
    echo -e "${BLUE}========================================${NC}"
    echo ""
    echo -e "${RED}Failed tests:${NC}"
    for test in "${FAILED_TESTS[@]}"; do
        echo -e "${RED}  - $test${NC}"
    done
    echo ""
    echo -e "${YELLOW}Options:${NC}"
    echo "  1. Fix the failing tests"
    echo "  2. Skip tests with: SKIP_TESTS=true git commit ..."
    echo "  3. Bypass hook with: git commit --no-verify ..."
    echo ""
    echo -e "${YELLOW}Run tests manually:${NC}"
    echo "  ./gradlew :wear:testDebugUnitTest"
    
    exit 1
fi