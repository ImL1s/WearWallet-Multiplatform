# CocoaPods 官方源（必需）
source 'https://cdn.cocoapods.org'

# 抑制 CocoaPods 警告
inhibit_all_warnings!

use_frameworks!

# Workspace 配置
workspace 'WearWallet'

# iOS App Target - TEMPORARILY DISABLED to fix watchOS build
# Uncomment when iOS companion app is needed
# target 'WatchWallet' do
