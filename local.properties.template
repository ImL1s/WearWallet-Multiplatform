# ============================================
# WearWallet local.properties template
# ============================================
#
# Copy to local.properties (gitignored) and fill only what you need.
# Do not commit real values. Placeholders only.
#
# Wear OS BuildConfig and coreKmp BuildKonfig use different key names.
# See docs/API_CONFIGURATION.md.
#
# ============================================

# Android SDK (required for local Wear / mobile Gradle). Android Studio can
# write this line when you open the project.
sdk.dir=/Users/YOUR_USERNAME/Library/Android/sdk

# ==================== Wear OS BuildConfig (lowercase) ====================
# Read by wear/build.gradle.kts. Env fallbacks: INFURA_PROJECT_ID,
# ETHERSCAN_API_KEY, MORALIS_API_KEY.
infura.project.id=
etherscan.api.key=
moralis.api.key=

# GOOGLE_AI_API_KEY is not read from this file. Use the environment or a
# Gradle property (see .env.example / gradle.properties.example).

# ==================== coreKmp BuildKonfig (uppercase) ====================
# Read by coreKmp/build.gradle.kts from this file only (not env).

# Infura: https://infura.io
INFURA_API_KEY=
INFURA_HOLESKY_KEY=
INFURA_POLYGON_KEY=

# Explorers
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=
OPTIMISM_API_KEY=
BSCSCAN_API_KEY=

# DEX / Web3
RANGO_API_KEY=
ZEROX_API_KEY=
MORALIS_API_KEY=
TRON_API_KEY=
GETBLOCK_API_KEY=
