<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Strip overlay / mic permissions even if a dependency redeclares them. -->
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.MODIFY_AUDIO_SETTINGS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"
        tools:node="remove" />

    <application>
        <!-- Debug/maintenance activities must never survive into release merge. -->
        <activity
            android:name=".presentation.voice.VoiceCommandActivity"
            tools:node="remove" />
        <activity
            android:name=".presentation.debug.MoneroDeviceTestActivity"
            tools:node="remove" />
        <service
            android:name=".ai.system.WearWalletGeminiLiveService"
            tools:node="remove" />
    </application>
</manifest>
