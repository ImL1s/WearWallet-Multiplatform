# Local environment template. Copy to `.env` and fill values locally.
# Never commit real credentials. Keep names aligned with Gradle consumers.
# sdk.dir belongs in ignored local.properties, not here.
# coreKmp BuildKonfig reads uppercase keys from local.properties, not these env names.

# GitHub Packages (settings.gradle.kts)
GITHUB_ACTOR=
GITHUB_TOKEN=

# Wear OS build configuration (wear/build.gradle.kts)
INFURA_PROJECT_ID=
ETHERSCAN_API_KEY=
MORALIS_API_KEY=
GOOGLE_AI_API_KEY=
