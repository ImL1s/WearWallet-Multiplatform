# Local environment template. Copy to `.env` and fill values locally.
# Never commit real credentials. Keep names aligned with Gradle consumers.
# sdk.dir belongs in ignored local.properties, not here.
# coreKmp BuildKonfig reads uppercase keys from local.properties, not these env names.
# Gradle does not load this file. Before ./gradlew: set -a; source .env; set +a
# (or scripts/build-with-validation.sh). See docs/API_CONFIGURATION.md.
# Leave unused keys commented. A present-but-empty GITHUB_TOKEN overrides
# github.token in ~/.gradle/gradle.properties (settings.gradle.kts reads env first).

# GitHub Packages (settings.gradle.kts)
# GITHUB_ACTOR=
# GITHUB_TOKEN=

# Wear OS build configuration (wear/build.gradle.kts)
# INFURA_PROJECT_ID=
# ETHERSCAN_API_KEY=
# MORALIS_API_KEY=
# GOOGLE_AI_API_KEY=
