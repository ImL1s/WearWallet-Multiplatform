# Gradle Configuration Example
# Copy to gradle.properties or set environment variables

# Optional GitHub credentials for package resolution (can also use GITHUB_ACTOR / GITHUB_TOKEN env vars)
# github.actor=
# github.token=

android.useAndroidX=true
kotlin.code.style=official
org.gradle.jvmargs=-Xmx6144m -XX:MaxMetaspaceSize=1536m
kotlin.daemon.jvmargs=-Xmx2048m -XX:MaxMetaspaceSize=512m
org.gradle.parallel=false
org.gradle.caching=false
kotlin.compiler.execution.strategy=daemon
kotlin.incremental=false
kotlin.native.ignoreDisabledTargets=true
kotlin.mpp.applyDefaultHierarchyTemplate=false
