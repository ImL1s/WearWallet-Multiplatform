# Gradle configuration example for local overrides.
# Copy selected keys into user-level ~/.gradle/gradle.properties, or pass -P.
# Never put github.actor / github.token into the tracked gradle.properties.

# Optional GitHub Packages credentials (read:packages) if TrustWallet Core 401s:
# github.actor=
# github.token=

# Public clones: skip Firebase / Google Services (no real google-services.json).
# publicSnapshot=true

# Wear BuildConfig Google AI field (not read from local.properties):
# GOOGLE_AI_API_KEY=

# Optional Wear release signing (wear/build.gradle.kts). Not a Play upload path.
# WEARWALLET_STORE_FILE=
# WEARWALLET_STORE_PASSWORD=
# WEARWALLET_KEY_ALIAS=
# WEARWALLET_KEY_PASSWORD=

android.useAndroidX=true
kotlin.code.style=official
org.gradle.jvmargs=-Xmx6144m -XX:MaxMetaspaceSize=1536m
kotlin.daemon.jvmargs=-Xmx4096m -XX:MaxMetaspaceSize=1024m
org.gradle.parallel=false
org.gradle.workers.max=2
org.gradle.caching=false
kotlin.compiler.execution.strategy=in-process
kotlin.incremental=false
kotlin.native.ignoreDisabledTargets=true
kotlin.mpp.applyDefaultHierarchyTemplate=false
org.gradle.vfs.watch=false
